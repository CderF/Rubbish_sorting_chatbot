# Copy to /etc/rag-chatbot.env on the server (root-owned, mode 600) — NOT into
# the repo. systemd loads it via EnvironmentFile=.
#
#   sudo tee /etc/rag-chatbot.env > /dev/null <<'EOF'
#   ...contents...
#   EOF
#   sudo chown root:root /etc/rag-chatbot.env
#   sudo chmod 600 /etc/rag-chatbot.env
#
# Generate a password with:  openssl rand -base64 12

# Login for the WebUI. The username is only needed for HTTP Basic auth
# (curl -u); the browser login form asks for the password only.
WEBUI_USER=mentor
WEBUI_PASSWORD=replace-me

# Source IPs allowed to call POST /chat. That endpoint has no authentication
# (the grading server sends no auth headers), so it is restricted by IP instead.
# 127.0.0.1 is kept so local curl checks keep working.
GRADER_IPS=160.251.239.96,127.0.0.1

# Optional: where the model weights were downloaded to.
# Defaults to ~/models/Qwen3-VL-8B-Instruct
# MODEL_PATH=/home/teamb2/models/Qwen3-VL-8B-Instruct
