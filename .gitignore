# --- secrets ---------------------------------------------------------------
# The real values live in /etc/rag-chatbot.env (root-owned, mode 600) on the
# server. Only .env.example belongs in the repo.
.env
.env.*
!.env.example
*rag-chatbot.env

# --- model weights (17GB, re-downloadable) ---------------------------------
models/
*.safetensors
*.gguf

# --- python ----------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- runtime artefacts -----------------------------------------------------
server.log
*.log
.cache/
.triton/
.nv/
var/
*.db
.tilelang/

# --- confidential material -------------------------------------------------
# NOTE: documents/課題.pdf is ALREADY TRACKED and pushed, so this rule has no
# effect on it today — .gitignore only applies to untracked files. It is kept
# here so the file is not re-added if it is ever untracked. The PDF is marked
# "Strictly confidential for internal use only" by GMO; see README / team
# decision on whether it should be purged from history.
documents/課題.pdf
# Renamed copy of the same confidential PDF; never tracked, keep it that way.
documents/北九州ゴミ分類Chatbot課題.pdf

# --- data artefacts (STAGE 02-04) ----------------------------------------
# var/ + *.db (above) hold the crawler's SQLite DB and STAGE 04 ingest output —
# generated from the crawl + ingested お知らせ, not source. The STAGE04 sample
# お知らせ files now live under tests/fixtures/notices/ (test data only);
# knowledge/incoming/ is created on demand by the WebUI upload path.
*.sqlite
*.sqlite3
chroma/
.chroma/

