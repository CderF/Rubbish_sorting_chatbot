# --- secrets ---------------------------------------------------------------
# The real values live in /etc/rag-chatbot.env (root-owned, mode 600) on the
# server. Only .env.example belongs in the repo.
.env
.env.*
!.env.example
*rag-chatbot.env

# --- model weights (17GB, re-downloadable) ---------------------------------
models/
*.safetensors
*.gguf

# --- python ----------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- runtime artefacts -----------------------------------------------------
server.log
*.log
.cache/
.triton/
.nv/
var/
*.db
.tilelang/

